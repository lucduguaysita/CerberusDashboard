        '<span style="color:var(--red)">' + failedJobs + ' failed</span>' +
        (runningJobs > 0 ? ' / <span style="color:var(--blue)">' + runningJobs + ' running</span>' : '') +
        '</span></div>' +
        '<div class="scroll-panel">' +
        '<table class="data-table">' +
        '<thead><tr>' +
        '<th>Job Name</th><th>Status</th><th>Last Run</th><th>Duration</th>' +
        '<th>Next Run</th>' +
        '</tr></thead><tbody>';

        if (jobs.length === 0) {
        jobsHtml += '<tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:20px;">No jobs found or SQL Agent not running</td></tr>';
        } else {
        jobs.forEach(function (j) {
        var badgeCls = j.LastRunStatus === 1 ? 'badge-ok'
        : j.LastRunStatus === 0 ? 'badge-fail'
        : j.LastRunStatus === 4 ? 'badge-running'
        : !j.Enabled ? 'badge-disabled'
        : 'badge-unknown';
        var statusText = j.LastRunStatus === 1 ? 'OK'
        : j.LastRunStatus === 0 ? 'FAILED'
        : j.LastRunStatus === 4 ? 'RUNNING'
        : j.LastRunStatus === 3 ? 'CANCELLED'
        : !j.Enabled ? 'DISABLED'
        : 'UNKNOWN';

        var rowStyle = j.LastRunStatus === 0 ? ' style="background:rgba(231,76,60,0.04);"' : '';
        jobsHtml += '<tr' + rowStyle + '>' +
        '<td style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--teal);cursor:pointer;text-decoration:underline dotted;" ' +
        'onclick="cerberus.showJobHistory(\'' + escHtml(inst.InstanceKey) + '\',\'' + j.JobId + '\',\'' + escHtml(j.JobName) + '\')" ' +
        'title="Click to view history">' + escHtml(j.JobName) + '</td>' +
        '<td><span class="badge ' + badgeCls + '">' + statusText + '</span></td>' +
        '<td style="white-space:nowrap;">' + fmtDate(j.LastRunDateTime) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtDuration(j.LastRunDurationSeconds) + '</td>' +
        '<td style="white-space:nowrap;">' + fmtDate(j.NextRunDateTime) + '</td>' +
        '</tr>';
        });
        }

        jobsHtml += '</tbody></table></div></div>';

        // ── Blocking Panel ──
        var midRow = '';

        midRow += '<div class="panel" style="margin-bottom:12px;"><div class="panel-header teal-accent"><span class="panel-title" style="color:var(--teal);">Blocking / Long Waits</span>' +
        '<span class="panel-badge teal" style="' + (blocked.length > 0 ? 'color:var(--red);border-color:var(--red-dim)' : '') + '">' + blocked.length + '</span>' +
        '</div><div class="scroll-panel">' +
        '<table class="data-table"><thead><tr>' +
        '<th>SPID</th><th>Blocked By</th><th>DB</th><th>Wait</th><th>Wait ms</th><th>SQL</th>' +
        '</tr></thead><tbody>';

        if (blocked.length === 0) {
        midRow += '<tr><td colspan="6" style="text-align:center;color:var(--green);padding:20px;">✓ No blocking detected</td></tr>';
        } else {
        blocked.forEach(function (b) {
        midRow += '<tr>' +
        '<td style="font-family:var(--font-mono);">' + b.SessionId + '</td>' +
        '<td style="font-family:var(--font-mono);color:var(--red);">' + (b.BlockingSessionId > 0 ? b.BlockingSessionId : '—') + '</td>' +
        '<td>' + escHtml(b.DatabaseName) + '</td>' +
        '<td style="font-family:var(--font-mono);font-size:10px;">' + escHtml(b.WaitType) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + b.WaitTimeMs + '</td>' +
        '<td><span class="sql-text" title="' + escHtml(b.SqlText) + '">' + escHtml(b.SqlText) + '</span></td>' +
        '</tr>';
        });
        }

        midRow += '</tbody></table></div></div>';

        // ── Expensive Queries Panel ──
        var expensiveQueries = inst.ExpensiveQueries || [];
        midRow += '<div class="panel" style="margin-bottom:12px;"><div class="panel-header teal-accent"><span class="panel-title" style="color:var(--teal);">Recent Expensive Queries</span>' +
        '<span class="panel-badge teal">Last 15 minutes</span>' +
        '</div><div class="scroll-panel">' +
        '<table class="data-table"><thead><tr>' +
        '<th>Avg Elapsed</th><th>DB</th><th>Exec Count</th><th>Total CPU ms</th><th>Avg CPU ms</th><th>Last Exec</th><th>Query</th>' +
        '</tr></thead><tbody>';

        if (expensiveQueries.length === 0) {
        midRow += '<tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:20px;">No expensive queries in the last 15 minutes</td></tr>';
        } else {
        expensiveQueries.slice().sort(function (a, b) {
        var aHot = a.ExecutionCount >= 1000 ? 1 : 0;
        var bHot = b.ExecutionCount >= 1000 ? 1 : 0;
        if (aHot !== bHot) return bHot - aHot;
        return (b.AvgElapsedMs || 0) - (a.AvgElapsedMs || 0);
        }).forEach(function (q) {
        var elapsedClass = q.TotalElapsedMs > 10000 ? 'crit' : q.TotalElapsedMs > 5000 ? 'warn' : 'ok';
        var avgElapsedClass = q.AvgElapsedMs > 5000 ? 'crit' : q.AvgElapsedMs > 1000 ? 'warn' : 'ok';
        var cpuClass = q.TotalCpuMs > 10000 ? 'crit' : q.TotalCpuMs > 5000 ? 'warn' : 'ok';
        midRow += '<tr>' +
        '<td style="font-family:var(--font-mono);color:var(--' + avgElapsedClass + ');">' + fmtElapsedMs(q.AvgElapsedMs) + '</td>' +
        '<td style="white-space:nowrap;">' + escHtml(q.DatabaseName) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + q.ExecutionCount.toLocaleString() + '</td>' +
        '<td style="font-family:var(--font-mono);color:var(--' + cpuClass + ');">' + fmt(q.TotalCpuMs, 0) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmt(q.AvgCpuMs, 1) + '</td>' +
        '<td style="font-family:var(--font-mono);font-size:11px;white-space:nowrap;">' + fmtDate(q.LastExecutionTime) + '</td>' +
        '<td><span class="sql-text" ' +
        'style="cursor:pointer;color:var(--teal);text-decoration:underline dotted;" ' +
        'data-instance="' + escHtml(inst.InstanceKey) + '" ' +
        'data-planhandle="' + escHtml(q.PlanHandle || '') + '" ' +
        'onclick="cerberus.showQueryPlan(this)" ' +
        'title="Click to view execution plan">' +
        escHtml(q.QueryText) + '</span></td>' +
        '</tr>';
        });
        }

        midRow += '</tbody></table></div></div>';

        // ── Active Queries Panel (sorted by AvgElapsedMs desc, TotalElapsed removed) ──
        var longRunning = recentQueries.filter(function (q) { return q.TotalElapsedMs >= 5000; }).length;

        var recentHtml = '<div class="panel" style="margin-bottom:12px;">' +
        '<div class="panel-header teal-accent">' +
        '<span class="panel-title" style="color:var(--teal);">Active Queries</span>' +
        '<div style="display:flex;gap:8px;align-items:center;">' +
        (longRunning > 0
        ? '<span class="panel-badge" style="color:var(--red);border-color:var(--red-dim);">' + longRunning + ' long-running</span>'
        : '') +
        '<span class="panel-badge teal">' + recentQueries.length + '</span>' +
        '</div>' +
        '</div>' +
        '<div class="scroll-panel">' +
        '<table class="data-table"><thead><tr>' +
        '<th>Avg Elapsed</th>' +
        '<th>DB</th>' +
        '<th>Exec Count</th>' +
        '<th>Total CPU ms</th>' +
        '<th>Avg CPU ms</th>' +
        '<th>Last Exec</th>' +
        '<th>Query</th>' +
        '</tr></thead><tbody>';

        if (recentQueries.length === 0) {
        recentHtml += '<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:20px;">No queries with elapsed time > 300ms in last 24h</td></tr>';
        } else {
        recentQueries.slice().sort(function (a, b) {
        var aHot = a.ExecutionCount >= 1000 ? 1 : 0;
        var bHot = b.ExecutionCount >= 1000 ? 1 : 0;
        if (aHot !== bHot) return bHot - aHot;
        return (b.AvgElapsedMs || 0) - (a.AvgElapsedMs || 0);
        }).forEach(function (q) {
        var avgElapsedClass = q.AvgElapsedMs > 5000 ? 'crit' : q.AvgElapsedMs > 1000 ? 'warn' : 'ok';

        recentHtml += '<tr>' +
        '<td style="font-family:var(--font-mono);font-weight:700;color:var(--' + avgElapsedClass + ');">' + fmtElapsedMs(q.AvgElapsedMs) + '</td>' +
        '<td style="white-space:nowrap;">' + escHtml(q.DatabaseName || '—') + '</td>' +
        '<td style="font-family:var(--font-mono);">' + q.ExecutionCount.toLocaleString() + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmt(q.TotalCpuMs, 0) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmt(q.AvgCpuMs, 1) + '</td>' +
        '<td style="white-space:nowrap;font-size:11px;font-family:var(--font-mono);">' + fmtDate(q.LastExecuted) + '</td>' +
        '<td><span class="sql-text" ' +
        'style="cursor:pointer;color:var(--teal);text-decoration:underline dotted;" ' +
        'data-instance="' + escHtml(inst.InstanceKey) + '" ' +
        'data-planhandle="' + escHtml(q.PlanHandle || '') + '" ' +
        'onclick="cerberus.showQueryPlan(this)" ' +
        'title="Click to view execution plan">' +
        escHtml(q.QueryText) + '</span></td>' +
        '</tr>';
        });
        }

        recentHtml += '</tbody></table></div></div>';

        // ── Data File I/O Statistics ──
        var dataFileIO = inst.DataFileIO || [];
        var fileIOHtml = '<div class="panel" style="margin-bottom:12px;">' +
        '<div class="panel-header teal-accent"><span class="panel-title" style="color:var(--teal);">Data File I/O Statistics</span>' +
        '<span class="panel-badge teal">' + dataFileIO.length + '</span></div>' +
        '<div style="background:var(--bg-base);padding:8px 10px 4px;">' +
        '<canvas id="fileio-chart-' + escHtml(inst.InstanceKey) + '" style="width:100%;height:230px;display:block;border-radius:2px;"></canvas>' +
        '</div>' +
        '<div class="scroll-panel">' +
        '<table class="data-table"><thead><tr>' +
        '<th>Database</th><th>File Name</th><th>Type</th><th>Size</th>' +
        '<th>Reads</th><th>Writes</th><th>Read B/s</th><th>Write B/s</th><th>Read Latency</th><th>Write Latency</th>' +
        '</tr></thead><tbody>';

        if (dataFileIO.length === 0) {
        var fileIOMsg = inst.DataFileIOError
            ? '<span style="color:var(--red);">Query error: ' + escHtml(inst.DataFileIOError) + '</span>'
            : 'No file I/O data available';
        fileIOHtml += '<tr><td colspan="10" style="text-align:center;color:var(--text-muted);padding:20px;">' + fileIOMsg + '</td></tr>';
        } else {
        dataFileIO.forEach(function (f) {
        var readLatencyCls = f.AvgReadLatencyMs > 20 ? 'crit' : f.AvgReadLatencyMs > 10 ? 'warn' : 'ok';
        var writeLatencyCls = f.AvgWriteLatencyMs > 20 ? 'crit' : f.AvgWriteLatencyMs > 10 ? 'warn' : 'ok';
        var fileTypeCls = f.FileType === 'ROWS' ? 'badge-ok' : 'badge-unknown';

        fileIOHtml += '<tr>' +
        '<td style="font-weight:600;color:var(--text-primary);">' + escHtml(f.DatabaseName) + '</td>' +
        '<td style="font-family:var(--font-mono);font-size:11px;cursor:pointer;color:var(--teal);text-decoration:underline dotted;" ' +
        'onclick="cerberus.showFileDetail(\'' + escHtml(inst.InstanceKey) + '\',\'' + escHtml(f.DatabaseName) + '\',\'' + escHtml(f.FileName) + '\')" ' +
        'title="Click to view I/O history">' + escHtml(f.FileName) + '</td>' +
        '<td><span class="badge ' + fileTypeCls + '">' + escHtml(f.FileType) + '</span></td>' +
        '<td style="font-family:var(--font-mono);">' + fmtMb(f.SizeMb) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + f.NumReads.toLocaleString() + '</td>' +
        '<td style="font-family:var(--font-mono);">' + f.NumWrites.toLocaleString() + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtBytesPerSec(f.ReadBytesPerSec) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtBytesPerSec(f.WriteBytesPerSec) + '</td>' +
        '<td style="font-family:var(--font-mono);color:var(--' + readLatencyCls + ');">' + fmt(f.AvgReadLatencyMs, 2) + ' ms</td>' +
        '<td style="font-family:var(--font-mono);color:var(--' + writeLatencyCls + ');">' + fmt(f.AvgWriteLatencyMs, 2) + ' ms</td>' +
        '</tr>';
        });
        }

        fileIOHtml += '</tbody></table></div></div>';

        // ── Hot Tables ──
        var hotTables = inst.HotTables || [];
        var hotTablesHtml = '<div class="panel" style="margin-bottom:12px;">' +
        '<div class="panel-header teal-accent"><span class="panel-title" style="color:var(--teal);">Hot Tables</span>' +
        '<span class="panel-badge teal">' + hotTables.length + '</span>' +
        '<span style="font-size:10px;color:var(--text-muted);margin-left:auto;padding-right:4px;">DML rates over last refresh interval &mdash; first refresh shows no data</span>' +
        '</div>' +
        '<div class="scroll-panel">' +
        '<table class="data-table"><thead><tr>' +
        '<th>Database</th><th>Schema.Table</th>' +
        '<th title="Inserts per second">Ins/s</th>' +
        '<th title="Updates per second">Upd/s</th>' +
        '<th title="Deletes per second">Del/s</th>' +
        '<th title="Total DML per second">DML/s</th>' +
        '<th title="Reads (scans + lookups) per second">Reads/s</th>' +
        '<th title="Average row-lock wait time during the interval">Row Lock Avg ms</th>' +
        '<th title="Average page-lock wait time during the interval">Page Lock Avg ms</th>' +
        '</tr></thead><tbody>';

        if (hotTables.length === 0) {
        var hotTablesMsg = inst.HotTablesError
            ? '<span style="color:var(--red);">Query error: ' + escHtml(inst.HotTablesError) + '</span>'
            : 'No DML activity detected &mdash; data appears after the second refresh cycle';
        hotTablesHtml += '<tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:20px;">' + hotTablesMsg + '</td></tr>';
        } else {
        hotTables.forEach(function (t) {
        var dmlCls = t.TotalDmlPerSec > 1000 ? 'crit' : t.TotalDmlPerSec > 100 ? 'warn' : 'ok';
        var rowLockCls = t.AvgRowLockWaitMs > 100 ? 'crit' : t.AvgRowLockWaitMs > 10 ? 'warn' : 'ok';
        var pageLockCls = t.AvgPageLockWaitMs > 100 ? 'crit' : t.AvgPageLockWaitMs > 10 ? 'warn' : 'ok';
        var fmtRate = function(v) { return v > 0 ? v.toLocaleString(undefined, {maximumFractionDigits:1}) : '<span style="color:var(--text-muted)">—</span>'; };
        var fmtLock = function(v, cls) {
            return v > 0
                ? '<span style="color:var(--' + cls + ');">' + v.toLocaleString(undefined, {maximumFractionDigits:1}) + '</span>'
                : '<span style="color:var(--text-muted)">—</span>';
        };

        var tableLabel = escHtml(t.SchemaName + '.' + t.TableName);
        var tableCell = t.IsPartitioned
            ? '<span style="cursor:pointer;color:var(--teal);text-decoration:underline dotted;" ' +
              'title="Click to view partitions" ' +
              'onclick="cerberus.showPartitions(' +
                  '\'' + escHtml(inst.InstanceKey) + '\',' +
                  '\'' + escHtml(t.DatabaseName)  + '\',' +
                  '\'' + escHtml(t.SchemaName)    + '\',' +
                  '\'' + escHtml(t.TableName)     + '\')">' + tableLabel + ' &#9660;</span>'
            : '<span style="color:var(--text-secondary);">' + tableLabel + '</span>';

        hotTablesHtml += '<tr>' +
        '<td style="font-weight:600;color:var(--text-primary);">' + escHtml(t.DatabaseName) + '</td>' +
        '<td style="font-family:var(--font-mono);font-size:11px;">' + tableCell + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtRate(t.InsertsPerSec) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtRate(t.UpdatesPerSec) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtRate(t.DeletesPerSec) + '</td>' +
        '<td style="font-family:var(--font-mono);font-weight:600;color:var(--' + dmlCls + ');">' + fmtRate(t.TotalDmlPerSec) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtRate(t.ReadsPerSec) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtLock(t.AvgRowLockWaitMs, rowLockCls) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtLock(t.AvgPageLockWaitMs, pageLockCls) + '</td>' +
        '</tr>';
        });
        }

        hotTablesHtml += '</tbody></table></div></div>';

        // ── Databases Panel ──
        var dbHtml = '<div class="panel">' +
        '<div class="panel-header teal-accent"><span class="panel-title" style="color:var(--teal);">Databases</span>' +
        '<span class="panel-badge teal">' + dbs.length + '</span></div>' +
        '<div class="scroll-panel">' +
        '<table class="data-table"><thead><tr>' +
        '<th>Name</th><th>Status</th><th>Drive</th><th>Recovery</th><th>Data Size</th><th>Log Size</th>' +
        '<th>Last Full Backup</th><th>Last Log Backup</th>' +
        '</tr></thead><tbody>';

        if (dbs.length === 0) {
        dbHtml += '<tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:20px;">No user databases found</td></tr>';
        } else {
        dbs.forEach(function (db) {
        var backupAge = db.LastBackupDate ? Math.floor((new Date() - new Date(db.LastBackupDate)) / 3600000) : null;
        var backupCls = backupAge == null ? 'badge-unknown' : backupAge > 26 ? 'badge-fail' : 'badge-ok';
        var statusCls = db.Status === 'ONLINE' ? 'badge-ok' : 'badge-fail';

        dbHtml += '<tr>' +
        '<td style="color:var(--text-primary);font-weight:600;">' + escHtml(db.Name) + '</td>' +
        '<td><span class="badge ' + statusCls + '">' + escHtml(db.Status) + '</span></td>' +
        '<td style="font-family:var(--font-mono);font-weight:600;color:var(--accent);">' + (db.DataDrive ? escHtml(db.DataDrive) + ':' : '—') + '</td>' +
        '<td style="color:var(--text-muted);">' + escHtml(db.RecoveryModel) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtMb(db.SizeMb) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtMb(db.LogSizeMb) + '</td>' +
        '<td><span class="badge ' + backupCls + '">' + (db.LastBackupDate ? fmtDate(db.LastBackupDate) : 'NEVER') + '</span></td>' +
        '<td>' + fmtDate(db.LastLogBackupDate) + '</td>' +
        '</tr>';
        });
        }

        dbHtml += '</tbody></table></div></div>';

        return kpi + topRow + jobsHtml + midRow + recentHtml + fileIOHtml + hotTablesHtml + dbHtml;
        }

        // ─── Helper builders ──────────────────────────────────────────────────────
        function kpiCard(label, value, colorCls, sub, barCls) {
        return '<div class="kpi-card ' + colorCls + '">' +
        '<div class="kpi-label">' + label + '</div>' +
        '<div class="kpi-value">' + value + '</div>' +
        '<div class="kpi-sub">' + sub + '</div>' +
        '</div>';
        }

        function sRow(label, value) {
        return '<div class="server-info-row"><span class="sil">' + label + '</span><span class="siv">' + value + '</span></div>';
        }

        function perfRow(label, pct, cls) {
        return '<div style="margin-bottom:10px;">' +
        '<div style="display:flex;justify-content:space-between;margin-bottom:4px;">' +
        '<span class="sil">' + label + '</span></div>' +
        bar(pct, cls) + '</div>';
        }

        // ─── Tab switching ────────────────────────────────────────────────────────
        window.cerberus = {
        switchTab: function (key) {
        currentInstance = key;
        if (latestSnapshot) {
        var html = buildDashboard(latestSnapshot);
        document.getElementById('dashboard').innerHTML = html;
        }
        if (typeof connection !== 'undefined') invokeMonitor('SetActiveInstance', key);
        },

        showJobHistory: function (instanceKey, jobId, jobName) {
        document.getElementById('modal-job-name').textContent = jobName + ' — History';
        document.getElementById('modal-job-body').innerHTML =
        '<div class="skeleton-line"></div><div class="skeleton-line"></div>';
        document.getElementById('job-history-modal').classList.add('open');
        cerberus._signalrConnection.invoke("RequestJobHistory", instanceKey, jobId);
        },

        showJobHistoryFromEl: function (el) {
        var instanceKey = el.getAttribute('data-instance');
        var jobId = el.getAttribute('data-jobid');
        var jobName = el.getAttribute('data-jobname');
        cerberus.showJobHistory(instanceKey, jobId, jobName);
        },

        closeJobHistory: function () {
        document.getElementById('job-history-modal').classList.remove('open');
        },

        showQueryPlan: function (el) {
        var instanceKey = el.getAttribute('data-instance');
        var planHandle = el.getAttribute('data-planhandle');

        if (!planHandle) {
        alert('No execution plan available for this query.');
        return;
        }

        document.getElementById('modal-plan-title').textContent = 'Execution Plan — Loading...';
        document.getElementById('modal-plan-body').innerHTML =
        '<div class="skeleton-line"></div><div class="skeleton-line"></div>';
        document.getElementById('plan-download-link').style.display = 'none';
        document.getElementById('query-plan-modal').classList.add('open');

        cerberus._signalrConnection.invoke("RequestQueryPlan", instanceKey, planHandle);
        },

        closeQueryPlan: function () {
        document.getElementById('query-plan-modal').classList.remove('open');
        },

        showActiveSessions: function (instanceKey) {
        document.getElementById('modal-sessions-title').textContent = 'Active Sessions — ' + instanceKey;
        document.getElementById('modal-sessions-body').innerHTML =
        '<div class="skeleton-line"></div><div class="skeleton-line"></div>';
        document.getElementById('active-sessions-modal').classList.add('open');
        cerberus._signalrConnection.invoke("RequestActiveSessions", instanceKey);
        },

        closeActiveSessions: function () {
        document.getElementById('active-sessions-modal').classList.remove('open');
        },

        showPartitions: function (instanceKey, dbName, schemaName, tableName) {
        document.getElementById('modal-partitions-title').textContent =
            dbName + ' • ' + schemaName + '.' + tableName;
        document.getElementById('modal-partitions-body').innerHTML =
            '<div class="skeleton-line"></div><div class="skeleton-line"></div>';
        document.getElementById('partitions-modal').classList.add('open');
        cerberus._signalrConnection.invoke(
            'RequestPartitionInfo', instanceKey, dbName, schemaName, tableName);
        },

        closePartitions: function () {
        document.getElementById('partitions-modal').classList.remove('open');
        },

        showFileDetail: function (instanceKey, dbName, fileName) {
        var modal = document.getElementById('file-detail-modal');
        modal.setAttribute('data-instance', instanceKey);
        modal.setAttribute('data-db', dbName);
        modal.setAttribute('data-file', fileName);
        document.getElementById('modal-filedetail-title').textContent =
            instanceKey + ' › ' + dbName + ' › ' + fileName;
        modal.classList.add('open');
        cerberus._drawFileDetailChart();
        },

        closeFileDetail: function () {
        document.getElementById('file-detail-modal').classList.remove('open');
        },

        _drawFileDetailChart: function () {
        var modal = document.getElementById('file-detail-modal');
        if (!modal.classList.contains('open')) return;
        var instanceKey = modal.getAttribute('data-instance');
        var dbName      = modal.getAttribute('data-db');
        var fileName    = modal.getAttribute('data-file');
        var fk = dbName + '|' + fileName;
        var canvas = document.getElementById('modal-filedetail-canvas');
        if (!canvas) return;
        var pL = 76, pR = 82;
        var getHist = function () { return ((_fileIOPerFile[instanceKey] || {})[fk]) || []; };
        drawIOHistoryChart(canvas, getHist(), null);
        canvas.style.cursor = 'crosshair';
        canvas.onmousemove = function (e) {
            var rect = canvas.getBoundingClientRect();
            var frac = Math.max(0, Math.min(1, (e.clientX - rect.left - pL) / (canvas.offsetWidth - pL - pR)));
            drawIOHistoryChart(canvas, getHist(), frac);
        };
        canvas.onmouseleave = function () {
            drawIOHistoryChart(canvas, getHist(), null);
        };
        },

        downloadPlan: function () {
        var xml = document.getElementById('query-plan-modal')
        .getAttribute('data-plan-xml');
        if (!xml) return;
        var blob = new Blob([xml], { type: 'application/xml' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'query_plan.sqlplan';
        a.click();
        }
        };

        // ─── SignalR ──────────────────────────────────────────────────────────────
        var connection = new signalR.HubConnectionBuilder()
        .withUrl("/signalr/monitorHub")
        .withAutomaticReconnect()
        .build();

        function invokeMonitor() {
        if (estateReloading || connection.state !== signalR.HubConnectionState.Connected) return Promise.resolve();
        return connection.invoke.apply(connection, arguments).catch(function () {
            document.getElementById('status-dot').className = 'pulse-dot error';
            document.getElementById('status-text').textContent = 'Request failed — refresh the dashboard';
        });
        }

        cerberus._signalrConnection = { invoke: invokeMonitor };

        function updateEstateControl() {
        document.getElementById('estate-select').disabled = estateReloading || estateSwitchPending ||
            !estateState || estateState.Estates.length < 2 || connection.state !== signalR.HubConnectionState.Connected;
        }

        function reloadEstate() {
        estateReloading = true;
        updateEstateControl();
        document.getElementById('dashboard').style.display = 'none';
        document.querySelectorAll('.modal-overlay.open').forEach(function (modal) { modal.classList.remove('open'); });
        document.getElementById('estate-message').textContent = 'Estate changed. Reloading dashboard...';
        window.location.reload();
        }

        connection.on('receiveEstateState', function (state, connectionInitialized) {
        if (estateReloading) return;
        if (estateState) {
            if (state.SessionId !== estateState.SessionId || state.Revision > estateState.Revision ||
                (connectionInitialized && state.Revision !== estateState.Revision)) {
                reloadEstate();
                return;
            }
            if (state.Revision < estateState.Revision) return;
        }
        estateState = state;
        var select = document.getElementById('estate-select');
        select.replaceChildren();
        state.Estates.forEach(function (estate) {
            var option = document.createElement('option');
            option.value = estate.Key;
            option.textContent = estate.DisplayName;
            select.appendChild(option);
        });
        select.value = state.ActiveEstate;
        updateEstateControl();
        });

        document.getElementById('estate-form').addEventListener('submit', function (event) { event.preventDefault(); });
        document.getElementById('estate-select').addEventListener('change', async function () {
        if (!estateState || estateSwitchPending || estateReloading) return;
        var select = this;
        var form = document.getElementById('estate-form');
        var data = new FormData(form);
        data.set('revision', estateState.Revision);
        data.set('sessionId', estateState.SessionId);
        estateSwitchPending = true;
        updateEstateControl();
        document.getElementById('estate-message').textContent = 'Switching estate for all users...';
        try {
            var response = await fetch(form.action, { method: 'POST', body: data, credentials: 'same-origin' });
            if (response.status === 409 || response.ok) {
                reloadEstate();
                return;
            }
            throw new Error('Estate selection was rejected.');
        } catch (error) {
            select.value = estateState.ActiveEstate;
            document.getElementById('estate-message').textContent = 'Could not switch estate. Refresh to confirm the active estate before retrying.';
        } finally {
            estateSwitchPending = false;
            updateEstateControl();
        }
        });

        function onEstateEvent(name, handler) {
        connection.on(name, function () {
            var args = Array.prototype.slice.call(arguments);
            var revision = args.pop();
            if (!estateState || estateReloading || revision !== estateState.Revision) return;
            handler.apply(null, args);
        });
        }

        onEstateEvent("receiveQueryPlan", function (plan) {
        var modal = document.getElementById('query-plan-modal');
        var body = document.getElementById('modal-plan-body');
        var title = document.getElementById('modal-plan-title');
        var dlLink = document.getElementById('plan-download-link');

        if (plan.ErrorMessage) {
        title.textContent = 'Execution Plan \u2014 Error';
        body.innerHTML = '<p style="color:var(--red);padding:20px;font-family:var(--font-mono);">' +
        escHtml(plan.ErrorMessage) + '</p>';
        return;
        }

        if (!plan.PlanXml) {
        title.textContent = 'Execution Plan \u2014 Not Available';
        body.innerHTML = '<p style="color:var(--text-muted);padding:20px;">No cached plan found for this query. ' +
        'The plan may have been evicted from cache.</p>';
        return;
        }

        modal.setAttribute('data-plan-xml', plan.PlanXml);
        dlLink.style.display = 'inline';
        title.textContent = 'Execution Plan';

        try {
        var parser = new DOMParser();
        var xmlDoc = parser.parseFromString(plan.PlanXml, 'text/xml');
        var relOps = xmlDoc.getElementsByTagName('RelOp');
        var nodes = [];

        for (var i = 0; i < relOps.length; i++) {
        var op = relOps[i];
        var opName = op.getAttribute('PhysicalOp') || op.getAttribute('LogicalOp') || 'Unknown';
        var cost = parseFloat(op.getAttribute('EstimatedTotalSubtreeCost') || '0');
        var rows = parseFloat(op.getAttribute('EstimateRows') || '0');
        var executions = parseFloat(op.getAttribute('EstimateExecutions') || '1');
        nodes.push({ opName: opName, cost: cost, rows: rows, executions: executions });
        }

        nodes.sort(function (a, b) { return b.cost - a.cost; });
        var maxCost = nodes.length > 0 ? nodes[0].cost : 1;

        var html = '<div style="margin-bottom:12px;"><span style="font-size:11px;color:var(--text-muted);">Showing top ' +
        Math.min(nodes.length, 20) + ' operations by cost. Download .sqlplan to open in SSMS for full graphical plan.</span></div>';

        html += '<table class="data-table" style="margin-bottom:16px;"><thead><tr>' +
        '<th>Operation</th><th>Est. Cost</th><th>Cost %</th><th>Est. Rows</th><th>Executions</th>' +
        '</tr></thead><tbody>';

        nodes.slice(0, 20).forEach(function (n) {
        var pct = maxCost > 0 ? (n.cost / maxCost * 100) : 0;
        var barColor = pct >= 50 ? 'var(--red)' : pct >= 20 ? 'var(--yellow)' : 'var(--green)';
        html += '<tr><td style="font-family:var(--font-mono);font-size:11px;">' + escHtml(n.opName) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + n.cost.toFixed(4) + '</td>' +
        '<td><div class="metric-bar-wrap"><div class="metric-bar-track">' +
        '<div class="metric-bar-fill" style="width:' + pct.toFixed(1) + '%;background:' + barColor + '"></div>' +
        '</div><span class="metric-bar-val">' + pct.toFixed(1) + '%</span></div></td>' +
        '<td style="font-family:var(--font-mono);">' + Math.round(n.rows) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + Math.round(n.executions) + '</td></tr>';
        });

        html += '</tbody></table>';
        html += '<div style="margin-bottom:8px;font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.8px;">Query Text</div>';
        html += '<div class="plan-xml" style="max-height:120px;">' + escHtml(plan.QueryText || '') + '</div>';
        body.innerHTML = html;
        } catch (err) {
        body.innerHTML = '<div class="plan-xml">' + escHtml(plan.PlanXml) + '</div>';
        }
        });

        onEstateEvent("receiveProgress", function (message, pct) {
        var bar = document.getElementById('load-bar');
        var step = document.getElementById('load-step');
        var log = document.getElementById('load-log');

        if (bar) bar.style.width = Math.max(2, pct) + '%';
        if (step) step.textContent = message;

        if (log) {
        var line = document.createElement('div');
        line.textContent = message;
        if (message.indexOf('\u2713') !== -1) {
        line.style.color = 'var(--green)';
        } else if (message.indexOf('\u2192') !== -1) {
        line.style.color = 'var(--text-muted)';
        } else {
        line.style.color = 'var(--text-secondary)';
        }
        log.appendChild(line);
        log.scrollTop = log.scrollHeight;
        }
        });

        // Live clock — ticks every second regardless of snapshot state
        (function () {
        var el = document.getElementById('last-updated');
        var pad = function (n) { return n.toString().padStart(2, '0'); };
        function tick() {
            var now = new Date();
            el.textContent = pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
        }
        tick();
        setInterval(tick, 1000);
        })();

        var _countdownInterval = null;
        var _refreshIntervalSec = 30;

        function startCountdown(seconds) {
        _refreshIntervalSec = seconds || 30;
        var remaining = _refreshIntervalSec;
        var el = document.getElementById('next-refresh');
        if (_countdownInterval) clearInterval(_countdownInterval);
        _countdownInterval = setInterval(function () {
            remaining--;
            if (remaining <= 0) {
            el.textContent = 'next refresh: refreshing...';
            } else {
            el.textContent = 'next refresh: ' + remaining + 's';
            }
        }, 1000);
        el.textContent = 'next refresh: ' + remaining + 's';
        }

        cerberus.manualRefresh = function () {
        var el = document.getElementById('next-refresh');
        el.textContent = 'next refresh: refreshing...';
        if (_countdownInterval) clearInterval(_countdownInterval);
        invokeMonitor("RequestInitialData");
        };

        onEstateEvent("receiveSnapshot", function (snapshot) {
        var dot = document.getElementById('status-dot');
        var statusText = document.getElementById('status-text');
        var loading = document.getElementById('loading-state');
        var dashboard = document.getElementById('dashboard');

        dot.className = 'pulse-dot ok';
        statusText.textContent = 'Live';

        // Merge partial (single-instance background refresh) into the cached full snapshot
        if (latestSnapshot && snapshot.Instances && snapshot.Instances.length === 1) {
            var updated = snapshot.Instances[0];
            for (var i = 0; i < latestSnapshot.Instances.length; i++) {
                if (latestSnapshot.Instances[i].InstanceKey === updated.InstanceKey) {
                    latestSnapshot.Instances[i] = updated;
                    break;
                }
            }
            snapshot = latestSnapshot;
        }

        loading.style.display = 'none';
        dashboard.style.display = 'block';
        dashboard.innerHTML = buildDashboard(snapshot);

        // Update file I/O history and redraw charts
        (snapshot.Instances || []).forEach(function (inst) {
            if (inst.IsOnline) {
                updateFileIOHistory(inst.InstanceKey, inst.DataFileIO || []);
                updateFileIOPerFile(inst.InstanceKey, inst.DataFileIO || []);
                drawFileIOChart(inst.InstanceKey);
            }
        });

        // Register active instance with server after first render
        if (currentInstance) invokeMonitor('SetActiveInstance', currentInstance);

        startCountdown(snapshot.RefreshIntervalSeconds);
        document.getElementById('footer-refresh').textContent = 'Refresh: ' + snapshot.RefreshIntervalSeconds + ' s';
        });

        onEstateEvent("receiveJobHistory", function (jobId, history) {
        try {
        if (!history || history.length === 0) {
        document.getElementById('modal-job-body').innerHTML =
        '<p style="color:var(--text-muted);text-align:center;padding:20px;">No history found.</p>';
        return;
        }
        var html = '<table class="data-table" style="width:100%"><thead><tr>' +
        '<th>Step</th><th>Step Name</th><th>Status</th><th>Run Time</th><th>Duration</th><th>Retries</th>' +
        '</tr></thead><tbody>';
        history.forEach(function (h) {
        var isOutcome = h.StepId === 0;
        var badgeCls = h.RunStatus === 'Succeeded' ? 'badge-ok' : h.RunStatus === 'Failed' ? 'badge-fail' : h.RunStatus === 'Retry' ? 'badge-unknown' : 'badge-disabled';
        var rowStyle = isOutcome ? ' style="background:rgba(255,255,255,0.03);font-weight:600;"' : '';
        html += '<tr' + rowStyle + '><td style="font-family:var(--font-mono);">' + (isOutcome ? 'OUT' : h.StepId) + '</td>' +
        '<td>' + escHtml(h.StepName) + '</td>' +
        '<td><span class="badge ' + badgeCls + '">' + escHtml(h.RunStatus) + '</span></td>' +
        '<td style="white-space:nowrap;font-family:var(--font-mono);">' + fmtDate(h.RunDateTime) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtDuration(h.DurationSeconds) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + h.RetriesAttempted + '</td></tr>';
        if (h.Message) {
        html += '<tr><td colspan="6"><div class="step-message">' + escHtml(h.Message) + '</div></td></tr>';
        }
        });
        html += '</tbody></table>';
        document.getElementById('modal-job-body').innerHTML = html;
        } catch (err) {
        console.error('renderJobHistory error:', err);
        document.getElementById('modal-job-body').innerHTML = '<p style="color:var(--red);padding:20px;">Render error: ' + err.message + '</p>';
        }
        });

        onEstateEvent("receiveActiveSessions", function (sessions) {
        var body = document.getElementById('modal-sessions-body');
        if (!sessions || sessions.length === 0) {
        body.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:20px;">No active user sessions.</p>';
        return;
        }
        var html = '<table class="data-table" style="width:100%"><thead><tr>' +
        '<th>SPID</th><th>DB</th><th>Login</th><th>Host</th><th>Program</th><th>Status</th><th>Elapsed</th><th>CPU ms</th><th>Reads</th><th>Writes</th><th>Wait Type</th><th>Wait ms</th><th>Open Tx</th><th>Mem KB</th><th>Last Request</th><th>Query</th>' +
        '</tr></thead><tbody>';
        sessions.forEach(function (s) {
        var st = (s.Status || '').toLowerCase();
        var statusBadge = st === 'running' || st === 'runnable' ? '<span class="badge badge-running">' + escHtml(s.Status) + '</span>' :
        st === 'sleeping' ? '<span class="badge badge-disabled">' + escHtml(s.Status) + '</span>' :
        st === 'suspended' ? '<span class="badge badge-unknown">' + escHtml(s.Status) + '</span>' :
        '<span class="badge badge-recent">' + escHtml(s.Status || '\u2014') + '</span>';
        var blockedStyle = s.BlockingSessionId > 0 ? 'style="color:var(--red);font-weight:700;"' : '';
        var rowStyle = s.BlockingSessionId > 0 ? ' style="background:rgba(231,76,60,0.04);"' : '';
        html += '<tr' + rowStyle + '>' +
        '<td style="font-family:var(--font-mono);" ' + blockedStyle + '>' + s.SessionId + (s.BlockingSessionId > 0 ? ' \u27f5' + s.BlockingSessionId : '') + '</td>' +
        '<td>' + escHtml(s.DatabaseName) + '</td>' +
        '<td style="white-space:nowrap;">' + escHtml(s.LoginName) + '</td>' +
        '<td style="white-space:nowrap;font-size:11px;">' + escHtml(s.HostName) + '</td>' +
        '<td style="font-size:10px;color:var(--text-muted);max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + escHtml(s.ProgramName) + '">' + escHtml(s.ProgramName) + '</td>' +
        '<td>' + statusBadge + '</td>' +
        '<td style="font-family:var(--font-mono);">' + fmtElapsedMs(s.ElapsedMs) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + s.CpuTime + '</td>' +
        '<td style="font-family:var(--font-mono);">' + (s.LogicalReads || 0).toLocaleString() + '</td>' +
        '<td style="font-family:var(--font-mono);">' + (s.Writes || 0) + '</td>' +
        '<td style="font-family:var(--font-mono);font-size:10px;">' + escHtml(s.WaitType || '\u2014') + '</td>' +
        '<td style="font-family:var(--font-mono);">' + (s.WaitTimeMs || 0) + '</td>' +
        '<td style="font-family:var(--font-mono);">' + s.OpenTransactions + '</td>' +
        '<td style="font-family:var(--font-mono);">' + (s.MemoryKb || 0).toLocaleString() + '</td>' +
        '<td style="white-space:nowrap;font-size:11px;">' + fmtDate(s.LastRequestStart) + '</td>' +
        '<td><span class="sql-text" title="' + escHtml(s.SqlText) + '">' + escHtml(s.SqlText) + '</span></td>' +
        '</tr>';
        });
        html += '</tbody></table>';
        body.innerHTML = html;
        });

        onEstateEvent("receivePartitionInfo", function (info) {
        var body = document.getElementById('modal-partitions-body');
        if (!info) { body.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:20px;">No data returned.</p>'; return; }
        if (info.ErrorMessage) { body.innerHTML = '<p style="color:var(--red);padding:20px;">' + escHtml(info.ErrorMessage) + '</p>'; return; }

        var meta = '<div style="display:flex;gap:24px;flex-wrap:wrap;margin-bottom:14px;font-size:12px;">' +
            '<span><span style="color:var(--text-muted);">Function: </span><span style="font-family:var(--font-mono);color:var(--teal);">' + escHtml(info.PartitionFunction) + '</span></span>' +
            '<span><span style="color:var(--text-muted);">Scheme: </span><span style="font-family:var(--font-mono);color:var(--teal);">' + escHtml(info.PartitionScheme) + '</span></span>' +
            '<span><span style="color:var(--text-muted);">Column: </span><span style="font-family:var(--font-mono);color:var(--accent);">' + escHtml(info.PartitionColumn) + '</span></span>' +
            '<span><span style="color:var(--text-muted);">Partitions: </span><span style="font-family:var(--font-mono);">' + (info.Ranges ? info.Ranges.length : 0) + '</span></span>' +
        '</div>';

        if (!info.Ranges || info.Ranges.length === 0) {
            body.innerHTML = meta + '<p style="color:var(--text-muted);padding:20px;">No partitions found.</p>';
            return;
        }

        var tbl = '<table class="data-table"><thead><tr>' +
            '<th>#</th><th>Range Start</th><th>Range End</th><th>Row Count</th><th>Compression</th>' +
            '</tr></thead><tbody>';

        info.Ranges.forEach(function (r) {
            var isLast  = r.PartitionNumber === info.Ranges.length;
            var isFirst = r.PartitionNumber === 1;
            var start = isFirst ? '<span style="color:var(--text-muted);">&#x2212;&#x221E;</span>'
                : '<span style="font-family:var(--font-mono);">' + escHtml(r.RangeStart || '—') + '</span>';
            var end = isLast ? '<span style="color:var(--text-muted);">+&#x221E;</span>'
                : '<span style="font-family:var(--font-mono);">' + escHtml(r.RangeEnd || '—') + '</span>';
            var compCls = r.Compression === 'NONE' ? 'color:var(--text-muted)' : 'color:var(--teal)';
            tbl += '<tr>' +
                '<td style="font-family:var(--font-mono);font-weight:600;">' + r.PartitionNumber + '</td>' +
                '<td>' + start + '</td>' +
                '<td>' + end + '</td>' +
                '<td style="font-family:var(--font-mono);">' + (r.RowCount || 0).toLocaleString() + '</td>' +
                '<td style="font-size:11px;' + compCls + ';">' + escHtml(r.Compression || '—') + '</td>' +
            '</tr>';
        });

        tbl += '</tbody></table>';
        body.innerHTML = meta + tbl;
        });

        onEstateEvent("receiveFileIOUpdate", function (instanceKey, fileIOData) {
        updateFileIOPerFile(instanceKey, fileIOData || []);
        // Also keep aggregate chart history current for non-active instances
        updateFileIOHistory(instanceKey, fileIOData || []);
        // Redraw per-file detail modal if it belongs to this instance
        var modal = document.getElementById('file-detail-modal');
        if (modal.classList.contains('open') &&
            modal.getAttribute('data-instance') === instanceKey) {
            cerberus._drawFileDetailChart();
        }
        });

        onEstateEvent("receiveError", function (msg) {
        document.getElementById('status-dot').className = 'pulse-dot error';
        document.getElementById('status-text').textContent = 'Error';
        console.error('SignalR error: ' + msg);
        });

        connection.onreconnecting(function () {
        updateEstateControl();
        document.getElementById('status-dot').className = 'pulse-dot error';
        document.getElementById('status-text').textContent = 'Reconnecting...';
        });

        connection.onreconnected(function () {
        updateEstateControl();
        document.getElementById('status-dot').className = 'pulse-dot ok';
        document.getElementById('status-text').textContent = 'Live';
        invokeMonitor("RequestInitialData");
        });

        connection.onclose(function () {
        updateEstateControl();
        document.getElementById('status-dot').className = 'pulse-dot error';
        document.getElementById('status-text').textContent = 'Disconnected \u2014 reconnecting...';
        });

        connection.start()
        .then(function () {
        updateEstateControl();
        invokeMonitor("RequestInitialData");
        })
        .catch(function (err) {
        document.getElementById('status-dot').className = 'pulse-dot error';
        document.getElementById('status-text').textContent = 'Connection failed';
        document.getElementById('loading-state').innerHTML =
        '<p style="color:var(--red);font-family:var(--font-mono);">SignalR connection failed. Check WebSocket support.<br>' + err + '</p>';
        });

        })();
    </script>

