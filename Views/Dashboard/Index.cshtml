    <!-- ── Query Execution Plan Modal ────────────────────────────────────── -->
    <div class="modal-overlay" id="query-plan-modal">
        <div class="modal" style="max-width:1400px;">
            <div class="modal-header">
                <span class="panel-title" id="modal-plan-title">Execution Plan</span>
                <div style="display:flex;gap:12px;align-items:center;">
                    <a id="plan-download-link"
                       style="font-size:11px;color:var(--accent);cursor:pointer;display:none;"
                       onclick="cerberus.downloadPlan()">
