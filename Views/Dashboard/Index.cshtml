                <div class="skeleton-line"></div>
            </div>
        </div>
    </div>

    <!-- ── Active Sessions Modal ─────────────────────────────────────────── -->
    <div class="modal-overlay" id="active-sessions-modal">
        <div class="modal" style="max-width:1400px;">
            <div class="modal-header">
                <span class="panel-title" id="modal-sessions-title">Active Sessions</span>
                <button class="modal-close" onclick="cerberus.closeActiveSessions()">✕</button>
            </div>
            <div class="modal-body" id="modal-sessions-body">
                <div class="skeleton-line"></div>
                <div class="skeleton-line"></div>
            </div>
        </div>
    </div>

    <!-- ── File I/O Detail Modal ───────────────────────────────────────── -->
    <div class="modal-overlay" id="file-detail-modal">
        <div class="modal" style="max-width:1100px;">
            <div class="modal-header">
                <span class="panel-title" id="modal-filedetail-title">File I/O History</span>
                <button class="modal-close" onclick="cerberus.closeFileDetail()">✕</button>
            </div>
            <div class="modal-body" style="padding:12px;">
                <canvas id="modal-filedetail-canvas" style="width:100%;height:340px;display:block;background:#0d0f14;border-radius:2px;"></canvas>
            </div>
        </div>
    </div>

    <!-- ── Partitions Modal ──────────────────────────────────────────────── -->
    <div class="modal-overlay" id="partitions-modal">
        <div class="modal" style="max-width:900px;">
            <div class="modal-header">
                <span class="panel-title" id="modal-partitions-title">Partitions</span>
                <button class="modal-close" onclick="cerberus.closePartitions()">✕</button>
            </div>
            <div class="modal-body" id="modal-partitions-body">
                <div class="skeleton-line"></div>
                <div class="skeleton-line"></div>
            </div>
        </div>
    </div>

</body>
</html>
