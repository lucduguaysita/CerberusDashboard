{
  "// CONFIGURATION": "Single local estate using SQL Server LocalDB. Add estate sections with their own ConnectionStrings for additional environments, and supply credentials through protected deployment configuration rather than this file.",
  "DefaultEstate": "Local",
  "Estates": {
    "Local": {
      "DisplayName": "Local",
      "MonitorRefreshSeconds": 15,
      "MonitoredInstances": "LocalDB",
      "InstanceDisplayNames": "LocalDB",
      "ConnectionStrings": {
        "LocalDB": "Server=(local);Database=master;Integrated Security=True;TrustServerCertificate=True;Connection Timeout=15;"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://0.0.0.0:5001",
  "AllowedHosts": "*"
}
